{
  "version": 8,
  "name": "Crops",
  "metadata": {
    "description": "Fields coloured by harmonized crop (EuroCrops HCAT code, `hcat:code`). The crops covering the most area are named, everything else is grey. Colours follow the fiboa.org crop map palette."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../fields.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fields-by-crop",
      "type": "fill",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "fill-color": [
          "match",
          [
            "match",
            [
              "to-string",
              [
                "get",
                "hcat:code"
              ]
            ],
            "3301000000",
            "Arable land",
            "3303010000",
            "Orchard",
            "3303050000",
            "Olive grove",
            "3303060000",
            "Mother block of vines",
            "3303000000",
            "Mixed perennial crops",
            "3303070000",
            "Nursery",
            "3306000000",
            "Short rotation coppice",
            "Other"
          ],
          "Arable land",
          "#a6cee3",
          "Orchard",
          "#1f78b4",
          "Olive grove",
          "#b2df8a",
          "Mother block of vines",
          "#33a02c",
          "Mixed perennial crops",
          "#fb9a99",
          "Nursery",
          "#e31a1c",
          "Short rotation coppice",
          "#32cc4c",
          "#c8c8c8"
        ],
        "fill-opacity": 0.75
      }
    },
    {
      "id": "fields-by-crop-outline",
      "type": "line",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "line-color": "rgba(60,60,60,0.5)",
        "line-width": 0.5
      }
    }
  ]
}
