{
  "version": 8,
  "name": "Crops",
  "metadata": {
    "description": "Fields coloured by harmonized crop (EuroCrops HCAT code, `hcat:code`). The crops covering the most area are named, everything else is grey. Colours follow the fiboa.org crop map palette."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../fields.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fields-by-crop",
      "type": "fill",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "fill-color": [
          "match",
          [
            "match",
            [
              "to-string",
              [
                "get",
                "hcat:code"
              ]
            ],
            "3301000000",
            "ARABLE LAND",
            "3303040000",
            "CITRUS",
            "3303010000",
            "ASSOCIATION OF FRUIT TREES-NUT TREES",
            "3303050000",
            "OLIVAR – FRUIT",
            "3303030000",
            "DRIED FRUITS",
            "3303060000",
            "DRIED FRUITS AND VINEYARD",
            "Other"
          ],
          "ARABLE LAND",
          "#a6cee3",
          "CITRUS",
          "#cca532",
          "ASSOCIATION OF FRUIT TREES-NUT TREES",
          "#1f78b4",
          "OLIVAR – FRUIT",
          "#b2df8a",
          "DRIED FRUITS",
          "#33a02c",
          "DRIED FRUITS AND VINEYARD",
          "#fb9a99",
          "#c8c8c8"
        ],
        "fill-opacity": 0.75
      }
    },
    {
      "id": "fields-by-crop-outline",
      "type": "line",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "line-color": "rgba(60,60,60,0.5)",
        "line-width": 0.5
      }
    }
  ]
}
