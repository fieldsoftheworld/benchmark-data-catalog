{
  "version": 8,
  "name": "Chips of every collection",
  "metadata": {
    "description": "Coloured by split_admin2_v1: train green, val orange, test purple. Below zoom 7, each split's chip locations are clustered on their own and sized by count. From zoom 7, each chip is filled by its split, paler where it is in a presence-only collection, and outlined in red where its collections' own splits disagree."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://https://data.source.coop/ftw/benchmark-data/chips/chips.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f4f2"
      }
    },
    {
      "id": "overview-train",
      "type": "circle",
      "source": "data",
      "source-layer": "overview_train",
      "maxzoom": 7,
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "sqrt",
            [
              "get",
              "chips"
            ]
          ],
          1,
          2,
          30,
          7,
          100,
          14
        ],
        "circle-color": "#1b9e77",
        "circle-opacity": 0.75,
        "circle-stroke-color": "rgba(51,51,51,0.5)",
        "circle-stroke-width": 0.5
      }
    },
    {
      "id": "overview-val",
      "type": "circle",
      "source": "data",
      "source-layer": "overview_val",
      "maxzoom": 7,
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "sqrt",
            [
              "get",
              "chips"
            ]
          ],
          1,
          2,
          30,
          7,
          100,
          14
        ],
        "circle-color": "#d95f02",
        "circle-opacity": 0.9,
        "circle-stroke-color": "rgba(51,51,51,0.5)",
        "circle-stroke-width": 0.5
      }
    },
    {
      "id": "overview-test",
      "type": "circle",
      "source": "data",
      "source-layer": "overview_test",
      "maxzoom": 7,
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "sqrt",
            [
              "get",
              "chips"
            ]
          ],
          1,
          2,
          30,
          7,
          100,
          14
        ],
        "circle-color": "#7570b3",
        "circle-opacity": 0.9,
        "circle-stroke-color": "rgba(51,51,51,0.5)",
        "circle-stroke-width": 0.5
      }
    },
    {
      "id": "chips-by-admin2-split",
      "type": "fill",
      "source": "data",
      "source-layer": "chips",
      "minzoom": 7,
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "split_admin2_v1"
          ],
          "train",
          "#1b9e77",
          "val",
          "#d95f02",
          "test",
          "#7570b3",
          "#c8c8c8"
        ],
        "fill-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "presence_only"
            ],
            true
          ],
          0.3,
          0.7
        ]
      }
    },
    {
      "id": "chips-legacy-conflict",
      "type": "line",
      "source": "data",
      "source-layer": "chips",
      "minzoom": 7,
      "filter": [
        "==",
        [
          "get",
          "legacy_conflict"
        ],
        true
      ],
      "paint": {
        "line-color": "#d7301f",
        "line-width": 1
      }
    }
  ]
}
