{
  "version": 8,
  "name": "Crops",
  "metadata": {
    "description": "Fields coloured by harmonized crop (EuroCrops HCAT code, `hcat:code`). The crops covering the most area are named, everything else is grey. Colours follow the fiboa.org crop map palette."
  },
  "sources": {
    "data": {
      "type": "vector",
      "url": "pmtiles://../fields.pmtiles"
    }
  },
  "layers": [
    {
      "id": "fields-by-crop",
      "type": "fill",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "fill-color": [
          "match",
          [
            "match",
            [
              "to-string",
              [
                "get",
                "hcat:code"
              ]
            ],
            "3301090300",
            "Lucerne/Medics",
            "3301010100",
            "Wheat",
            "3301010400",
            "Barley",
            "3301060400",
            "Canola",
            "3301090000",
            "Small grain grazing",
            "Other"
          ],
          "Lucerne/Medics",
          "#a6cee3",
          "Wheat",
          "#cca532",
          "Barley",
          "#1f78b4",
          "Canola",
          "#b2df8a",
          "Small grain grazing",
          "#33a02c",
          "#c8c8c8"
        ],
        "fill-opacity": 0.75
      }
    },
    {
      "id": "fields-by-crop-outline",
      "type": "line",
      "source": "data",
      "source-layer": "fields",
      "paint": {
        "line-color": "rgba(60,60,60,0.5)",
        "line-width": 0.5
      }
    }
  ]
}
